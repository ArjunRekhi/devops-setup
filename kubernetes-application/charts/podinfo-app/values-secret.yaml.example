# Copy this next to the chart and fill in real values:
#
#   cp application/charts/podinfo-app/values-secret.yaml.example application/charts/values-secret.yaml
#   helm upgrade --install podinfo application/charts/podinfo-app -n podinfo -f application/charts/values-secret.yaml --atomic --wait
#
# The copy is gitignored. Keys must match values.yaml exactly — `apiKey`, not
# `API_KEY`. A wrong key is silently ignored: Helm merges what it is given, the
# chart falls back to its default, and nothing errors.
#
# Demonstrates the separation only. Helm values are stored in the release Secret
# and readable via `helm get values`, so this is the wrong home for production
# credentials.

secrets:
  apiKey: "change-me"
